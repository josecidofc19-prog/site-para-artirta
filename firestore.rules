rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra base: nega tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Editais públicos e fontes oficiais são abertos para leitura
    match /grants/{grantId} {
      allow read: if true;
      allow write: if false; // Somente via Admin/Seed
    }

    match /official_sources/{sourceId} {
      allow read: if true;
      allow write: if false;
    }

    // Coleções privadas do usuário (Cofre, Projetos, Inscrições)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /vault/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /projects/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /applications/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /analyses/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
